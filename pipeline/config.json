{
  "_doc": "Stage-1 ASMR smart-edit + master parameters. Every number used by analyze.py / master_audio.py lives here.",
  "fps": 60,
  "sampleRate": 48000,
  "audioTracks": [
    0,
    1
  ],
  "trim": {
    "preRollSec": 0.2,
    "postRollSec": 0.25,
    "recordHeadShakeSec": 0.5,
    "recordTailShakeSec": 0.5,
    "minDeadAirSec": 0.8,
    "minActionSec": 0.12,
    "audioActiveAboveFloorDb": 14.0,
    "audioAnalysisHighpassHz": 150,
    "motionActiveMultiplier": 4.5
  },
  "crossfade": {
    "ms": 35,
    "curve": "constant-power"
  },
  "dsp": {
    "highpass": {
      "hz": 75,
      "orderDbPerOct": 12
    },
    "denoise": {
      "reductionDb": 4.5,
      "noiseProfileSec": 0.6,
      "floorPercentile": 10
    },
    "eq": [
      {
        "type": "peak",
        "hz": 200,
        "gainDb": 1.5,
        "q": 0.5
      },
      {
        "type": "peak",
        "hz": 3500,
        "gainDb": 2.0,
        "q": 0.6
      },
      {
        "type": "highshelf",
        "hz": 10000,
        "gainDb": 1.5,
        "slope": 0.7
      }
    ],
    "compressor": {
      "ratio": 2.0,
      "attackMs": 27,
      "releaseMs": 90,
      "thresholdDb": -30,
      "kneeDb": 6
    },
    "loudness": {
      "targetLufs": -14.5,
      "minLufs": -16.0,
      "maxLufs": -14.0
    },
    "limiter": {
      "truePeakCeilingDbTP": -1.5,
      "lookaheadMs": 5,
      "releaseMs": 60,
      "oversample": 4
    }
  },
  "cuts": {
    "onsetHighpassHz": 800,
    "minRiseDb": 14,
    "minLevelAboveFloorDb": 22,
    "motionVsMedian": 1.3,
    "clusterGapSec": 0.9,
    "tailAboveFloorDb": 12,
    "minClipSec": 1.2,
    "maxClipSec": 3.5,
    "hardCapSec": 4.0,
    "targetClips": 27,
    "minSpacingSec": 4.0
  }
}